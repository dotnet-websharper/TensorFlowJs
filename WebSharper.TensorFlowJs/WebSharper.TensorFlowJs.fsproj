<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WebSharperProject>binding</WebSharperProject>
    <NoWarn>$(NoWarn);FS3886</NoWarn>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>WebSharper.TensorFlowJs 4.22.0+</Product>
    <Title>https://github.com/dotnet-websharper/TensorFlowJs/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) IntelliFactory</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NpmDependencies>
      <NpmPackage Name="@tensorflow/tfjs" Version="&gt;= 4.22.0 &lt; 5.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Enumeration.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Interfaces.fs" />
    <Compile Include="MainClasses.fs" />
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <Import Project="..\.paket\Paket.Restore.targets" />

</Project>
